# Supabase environment variables for AI LifeSaver
# Copy this file to .env and fill in your project values.
# Get these from: Supabase Dashboard → Project Settings → API

# Your Supabase project URL (e.g. https://xyzabc.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Your project's public anon key (safe to expose in the browser)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ---------------------------------------------------------------------------
# Gemini API key — DO NOT put it here or in any VITE_ variable.
# Store it only as a Supabase Edge Function secret:
#
#   npx supabase secrets set GEMINI_API_KEY=your_gemini_key
#   npx supabase secrets set GEMINI_MODEL=gemini-1.5-flash   # optional
#   npx supabase functions deploy ai-first-aid
#
# ---------------------------------------------------------------------------
